{
  "name": "stamas-monorepo",
  "version": "3.8.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python -m uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "build": "cd frontend && npm install && npm run build",
    "lint": "npm --prefix frontend run lint",
    "start:backend": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend",
    "install:all": "npm install && npm --prefix frontend install && pip install -r backend/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
