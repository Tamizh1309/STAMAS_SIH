# STAMAS Backend Environment Configuration (FastAPI)

# Server
PORT=8000

# Neon PostgreSQL (asyncpg). Keep the real value in backend/.env only — never commit.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google Gemini (server-side only — never expose to the browser)
# When omitted/empty, STAMAS runs on the deterministic Local Rule Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS — comma-separated allowed origins (Vite dev server included)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tender document ingestion (demo: local disk + in-memory metadata)
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_DOCUMENT_SIZE_MB=10
MAX_GEMINI_CHARS=12000
